# ============================================
# Database Configuration
# ============================================

# For local MongoDB (default on localhost:27017)
MONGODB_URI=mongodb://localhost:27017/event-invitations

# Alternative: For MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/event-invitations?retryWrites=true&w=majority

# ============================================
# Authentication
# ============================================

# Full URL where your app is hosted (change for production)
NEXTAUTH_URL=http://localhost:3000

# Secret for session encryption (generate with: openssl rand -hex 32)
# Change this in production!
NEXTAUTH_SECRET=your-super-secret-key-generate-with-openssl-rand-hex-32

# ============================================
# WhatsApp / Twilio Configuration
# ============================================

# Get these from your Twilio account: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ============================================
# Application Configuration
# ============================================

# Frontend URL (same as NEXTAUTH_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment (development, production)
NODE_ENV=development

# Admin secret for seeding data (change this in production)
ADMIN_SECRET=your-admin-secret-for-seed-routes

# ============================================
# Optional: Third-party Services
# ============================================

# Google Analytics (optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXX

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ============================================
# Optional: Payment Integration (Future)
# ============================================

# Stripe (for future payment implementation)
# STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxx

# ============================================
# Notes:
# ============================================
# 1. Copy this file to .env.local
# 2. Fill in all required values
# 3. Never commit .env.local to git
# 4. For production, use strong secret values
# 5. Environment variables starting with NEXT_PUBLIC_ are exposed to browser
