# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# For Vercel Deployment
# ============================================

# Database (MongoDB Atlas recommended for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/event-invitations?retryWrites=true&w=majority

# Authentication
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=generate-strong-secret-with-openssl-rand-hex-32

# WhatsApp / Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# Application
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NODE_ENV=production

# ============================================
# IMPORTANT NOTES:
# ============================================
# 1. DO NOT commit this file to git
# 2. Use Vercel Dashboard to set these variables
# 3. Use MongoDB Atlas (cloud) for production
# 4. Generate NEXTAUTH_SECRET: openssl rand -hex 32
# 5. Use strong, unique values for production
# 6. Keep TWILIO credentials secure
